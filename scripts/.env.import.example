# Copiez ce fichier en "scripts/.env.import" (il n'est jamais envoyé sur Git ni sur le site).
# Supabase → Project Settings → API

SUPABASE_URL=https://votre-projet.supabase.co

# Clé "service_role" : elle contourne la sécurité (RLS) pour pouvoir écrire les formations.
# ⚠ Ne la mettez JAMAIS dans le fichier .env du site ni dans un fichier commençant par VITE_.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Facultatif : autre adresse du fichier CSV Onisep (par défaut, le lien permanent data.gouv.fr)
# ONISEP_CSV_URL=
